# ─────────────────────────────────────────────────────────────────────────────
# Deploy settings for `yarn deploy` (scripts/deploy.mjs). Copy to `.env.deploy` (git-ignored).
# Server secrets live in deploy/.env, not here.
# ─────────────────────────────────────────────────────────────────────────────

# Cloudflare: My Profile → API Tokens → "Edit Cloudflare Workers" template. Or leave both empty
# and run `npx wrangler login` once in frontend/.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# The tunnel's public hostname for the API, e.g. https://lms-api.example.com (becomes the
# Worker's API_ORIGIN).
API_ORIGIN=

# The web app's public address, for the live checks (same as APP_URL in deploy/.env).
APP_URL=

# Cloudflare Access service token that lets the Worker (and only the Worker) through to the tunnel
# hostname: Zero Trust → Access → Service credentials → Service tokens. `yarn deploy secrets` copies
# these, and PROXY_SECRET from deploy/.env, into the Worker's secrets.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
