{
  "name": "lms-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LMS API — Hono on Node.js, PostgreSQL",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs",
    "create-admin": "tsx src/cli/create-admin.ts",
    "check-env": "tsx scripts/check-env.ts",
    "deploy:verify": "tsx scripts/verify-deploy.ts"
  },
  "dependencies": {
    "@gradio/client": "^2.7.1",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
