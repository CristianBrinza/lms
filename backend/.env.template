# ─────────────────────────────────────────────────────────────────────────────
# LMS API — local development. Copy to `.env` (git-ignored) and fill in.
# Production values live in deploy/.env on the server (see deploy/.env.template).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=8790
HOST=127.0.0.1

# `yarn db:up` starts PostgreSQL 16 in Docker on port 5433 with these credentials.
DATABASE_URL=postgres://lms:lms@127.0.0.1:5433/lms

# The web app's address (the Vite dev server). Requests that change data must come from here.
APP_URL=http://localhost:5190

# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# First admin, created on start when the database has no admin yet (then you can remove these).
# Or run: yarn create-admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_SURNAME=
