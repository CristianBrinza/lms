# ─────────────────────────────────────────────────────────────────────────────
# LMS server settings for deploy/docker-compose.yml. Copy to deploy/.env (git-ignored).
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL password (the database never leaves the Docker network).
POSTGRES_PASSWORD=

# The web app's public address (the Cloudflare Worker), e.g. https://lms.example.com
APP_URL=

# At least 32 random characters. Changing it signs everyone out; to rotate without that, move the
# old value to JWT_PREVIOUS_SECRET for a day.
JWT_SECRET=
JWT_PREVIOUS_SECRET=

# Shared with the Worker (yarn deploy secrets copies it there). Requests without it get a 404,
# so the public tunnel hostname cannot be used to get around the app.
PROXY_SECRET=

# Zero Trust → Networks → Tunnels → Create a tunnel (Cloudflared) → copy the token.
TUNNEL_TOKEN=

# First admin, created on first start when there is no admin yet. Remove the password afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_SURNAME=
