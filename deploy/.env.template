# ─────────────────────────────────────────────────────────────────────────────
# LMS server settings for deploy/docker-compose.yml, as deploy/.env (git-ignored, readable by the
# server's user only). deploy/server/setup.sh writes it: it generates the secrets and asks for the
# rest. By hand: copy this file and generate secrets with  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# This repo's absolute path on the machine (e.g. /home/cristian/lms). The updater runs
# `docker compose` itself and needs the same paths as the machine.
LMS_HOST_DIR=
# Who owns that checkout (id -u, id -g) and the Docker socket's group (stat -c %g /var/run/docker.sock):
# the updater runs as them.
LMS_UID=
LMS_GID=
DOCKER_GID=

# The branch the updater follows (it builds and releases each new commit itself).
LMS_BRANCH=main

# Signed deploys: the updater pulls only commits signed by a key in this file, kept on the machine
# outside the repo (setup.sh creates it). One line per key:  you@example.com namespaces="git" ssh-ed25519 AAAA…
LMS_ALLOWED_SIGNERS=
# Escape hatch, off: 1 deploys unsigned commits too. Only while setting signing up; then back to 0.
# LMS_ALLOW_UNSIGNED=0
# CHECK_EVERY=60        # seconds between checks

# Nightly backups to deploy/backups.
# BACKUP_AT=03:30
# KEEP_DAYS=14

TZ=Europe/Chisinau

# PostgreSQL password (the database never leaves the Docker network).
POSTGRES_PASSWORD=

# The app's public address (the tunnel's public hostname), e.g. https://lms.shades.md
APP_URL=

# At least 32 random characters. Changing it signs everyone out; to rotate without that, move the
# old value to JWT_PREVIOUS_SECRET for a day.
JWT_SECRET=
JWT_PREVIOUS_SECRET=

# Zero Trust → Networks → Tunnels → Create a tunnel (Cloudflared) → copy the token. Its public
# hostname (lms.shades.md) → service HTTP, api:8790.
TUNNEL_TOKEN=

# First admin, created on first start when there is no admin yet. Remove the password afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_SURNAME=

# Web push for reminders on phones. Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
