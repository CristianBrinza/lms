{
  "name": "lms-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LMS — Life Management System: the installable web app (React + Vite)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --cache",
    "test": "vitest run",
    "test:watch": "vitest",
    "brand": "node scripts/brand-assets.mjs --force"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@imgly/background-removal": "^1.7.0",
    "@mui/icons-material": "^9.4.0",
    "@tanstack/react-query": "^5.103.2",
    "onnxruntime-web": "1.21.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
